{{!
    @template mod_readaloud/questionheader

    Start of a quiz item: opens the item container and shows the title, question text and content. The
    container is closed by questionfooter.

    Context variables required for this template:
    * uniqueid - Unique id of the item, used to build element ids
    * itemtext - Question text (HTML)
    * rtl - CSS class for right-to-left languages, or empty
    * horizontal - Whether the item content uses the two column layout
    * title - Item title (HTML)
    * itemttsaudio - Text to read aloud with TTS

    Example context (json):
    {
        "id": 11,
        "number": 1,
        "type": "multichoice",
        "name": "Polar bears 1",
        "uniqueid": "multichoice1",
        "itemtext": "<p>Listen and answer the question about polar bears.</p>",
        "rtl": "",
        "horizontal": false,
        "title": "Polar bears"
    }
}}
<div id="{{uniqueid}}_container" class="readaloud_questioncontainer" style="display: none">

    {{> mod_readaloud/quiz_progress}}

    <audio id="{{uniqueid}}_player"></audio>
    <!-- @@CLOUDPOODLLTOKEN@@ -->
    {{#title}}
    <div class="readaloud_questionheader mt-4">
        {{{title}}}
    </div>
    {{/title}}
    {{#itemtext}}
    <div class="mod_readaloud_itemtext h5 fw-semibold my-4 {{rtl}}">
        {{{itemtext}}}
    </div>
    {{/itemtext}}
    {{#itemttsaudio}}
    <div class="mod_readaloud_itemttsaudio_cont">
        {{> mod_readaloud/ttsaudio}}
    </div>
    {{/itemttsaudio}}

    {{#horizontal}}
    <div class="row mt-3">
        <div class="col-sm-6">
    {{/horizontal}}
        <!-- Content -->
        {{> mod_readaloud/questioncontent}}
    {{#horizontal}}
        </div>
        <div class="col-sm-6">
    {{/horizontal}}