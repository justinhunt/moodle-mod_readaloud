{{!
    @template mod_readaloud/qi_freespeakingresults

    Results of a free speaking quiz item after AI evaluation.

    Context variables required for this template:
    * stats - Statistics: sentences, words, wordsunique, ideacount, relevance
    * markeduppassage - What the student said, marked up (HTML)
    * markedupcorrections - Corrected version, marked up (HTML)
    * percentscore - Score as a percentage
    * feedback - List of feedback strings
    * rtl - CSS class for right-to-left languages, or empty
    * noreattempt - Hide the reattempt button

    Example context (json):
    {
        "stats": {
            "sentences": 4,
            "words": 52,
            "wordsunique": 38,
            "ideacount": 3,
            "relevance": 90
        },
        "markeduppassage": "<span class=\"mod_readaloud_mu_word\">Polar</span> <span class=\"mod_readaloud_mu_word\">bear</span> live in the Arctic.",
        "markedupcorrections": "Polar <del class=\"mod_readaloud_mu_original_preword\">bear</del> <ins>bears</ins> live in the Arctic.",
        "percentscore": 80,
        "feedback": [
            "Good use of vocabulary.",
            "Check subject and verb agreement."
        ],
        "rtl": "",
        "noreattempt": false
    }
}}
<div class="ml_freespeaking_results">
<div class="ml_freespeaking_results_summaries">
  <div class="ml_fs_results_summary">
    <span class="ml_fs_sumcell_title">{{#str}}sentences, mod_readaloud{{/str}}</span>
    <span class="ml_fs_sumcell_content">{{stats.sentences}}</span>
  </div>
  <div class="ml_fs_results_summary">
    <span class="ml_fs_sumcell_title">{{#str}}totalwords, mod_readaloud{{/str}}</span>
    <span class="ml_fs_sumcell_content">{{stats.words}}</span>
  </div>
  <div class="ml_fs_results_summary">
    <span class="ml_fs_sumcell_title">{{#str}}uniquewords, mod_readaloud{{/str}}</span>
    <span class="ml_fs_sumcell_content">{{stats.wordsunique}}</span>
  </div>
  <div class="ml_fs_results_summary">
    <span class="ml_fs_sumcell_title">{{#str}}ideacount, mod_readaloud{{/str}}</span>
    <span class="ml_fs_sumcell_content">{{stats.ideacount}}</span>
  </div>
  <div class="ml_fs_results_summary">
    <span class="ml_fs_sumcell_title">{{#str}}relevance, mod_readaloud{{/str}}</span>
    <span class="ml_fs_sumcell_content">{{stats.relevance}}%</span>
  </div>
</div>
<div class="mlfsr_originaltext_container"><b>{{#str}}original, mod_readaloud{{/str}}:</b><br/><span class="mlfsr_originaltext">{{{markeduppassage}}}</span></div>
<div class="mlfsr_correctedtext_container"><b>{{#str}}corrected, mod_readaloud{{/str}}:</b><br/>
  <span class="mlfsr_correctedtext">{{{markedupcorrections}}}</span>
  {{>mod_readaloud/summary_togglecorrections}}
</div>
<div class="ml_freespeaking_results_summaries">
  <!-- not needed currently
  <div class="ml_fs_results_summary">
    <span class="ml_fs_sumcell_title">{{#str}}score , mod_readaloud{{/str}}</span>
    <span class="ml_fs_sumcell_content">{{rawscore}}/{{maxscore}}</span>
  </div>
  <div class="ml_fs_results_summary">
    <span class="ml_fs_sumcell_title">Words</span>
    <span class="ml_fs_sumcell_content">{{stats.words}}</span>
  </div>
  -->
  <div class="ml_fs_results_summary" style="margin: auto">
    <span class="ml_fs_sumcell_title">{{#str}}score , mod_readaloud{{/str}}</span>
    <span class="ml_fs_sumcell_content">{{percentscore}}%</span>
  </div>
</div>
</div>
<div class="ra_freespeaking_feedback">
<br/><b>{{#str}}aigrade_feedback_title , mod_readaloud{{/str}}:</b>
<ul class="{{rtl}}">
{{#feedback}}
<li>{{.}}</li>
{{/feedback}}
</ul>
</div>
{{^noreattempt}}
<div class="readaloud_actionbutton">
<a class="btn btn-secondary center" href="#" id = "{{uniqid}}_reattempt">
    {{#str}}reattempt, mod_readaloud{{/str}}</a>
</div>
{{/noreattempt}}
{{^element.frozen}}
{{#js}}
    require(['jquery', 'core/notification', 'core/log'], function($, notification, log) {
      var reattemptbutton = $('#{{uniqid}}_reattempt');
      reattemptbutton.on('click',function(e){
        e.preventDefault();
        notification.confirm('{{#str}}reattempt, mod_readaloud{{/str}}', 
                            '{{#str}}reallyreattempt, mod_readaloud{{/str}}',
                            '{{#str}}reattempt, mod_readaloud{{/str}}','',
                            function(){
                                reattemptbutton .closest('.ml_freespeaking_resultsbox').hide();
                                reattemptbutton .closest('.ml_freespeaking_pendingbox').hide();
                                reattemptbutton .closest('.ml_freespeaking_resultsbox').siblings('.ml_freespeaking_actionbox').show();
                            });
            
            
      });
    });
{{/js}}
{{/element.frozen}}
