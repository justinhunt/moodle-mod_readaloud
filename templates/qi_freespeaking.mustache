{{!
    @template mod_readaloud/qi_freespeaking

    Free speaking quiz item.

    Context variables required for this template:
    * uniqueid - Unique id of the item, used to build element ids
    * itemtext - Question text (HTML)
    * rtl - CSS class for right-to-left languages, or empty
    * horizontal - Whether the item content uses the two column layout
    * countwords - Whether to show the word count goal
    * targetwordcount - Target number of words
    * (recorder fields) - See ttrecorder

    Example context (json):
    {
        "id": 13,
        "number": 3,
        "type": "freespeaking",
        "name": "recordbutton",
        "uniqueid": "freespeaking3",
        "itemtext": "<p>Listen and answer the question about polar bears.</p>",
        "rtl": "",
        "horizontal": false,
        "passagehash": "en-US|abc123def456",
        "waveheight": 75,
        "region": "useast1",
        "language": "en-US",
        "asrurl": "https://useast.ls.poodll.com/transcribe",
        "speechtoken": "speech-token-value",
        "speechtokenregion": "useast1",
        "speechtokentype": "assemblyai",
        "speechtokenvalidseconds": 600,
        "forcestreaming": false,
        "maxtime": 60,
        "savemedia": 1,
        "savemediaregion": "useast1",
        "cloudpoodlltoken": "cloudpoodll-token-value",
        "wwwroot": "https://moodle.example.com",
        "appid": "mod_readaloud",
        "owner": "owner-hash-value",
        "transcode": 1,
        "transcribemedia": 1,
        "expiredays": 365,
        "mediatype": "audio",
        "cloudpoodllurl": "https://cloud.poodll.com",
        "label": "Record",
        "pressed": "false",
        "countwords": true,
        "targetwordcount": 50
    }
}}
{{> mod_readaloud/questionheader}}
<div class="readaloud_freespeaking_box">  
     <div class="ml_freespeaking_resultsbox"></div>
     <div class="ml_freespeaking_pendingbox hidden"><div class="text-center"><i class="fa-solid fa-spinner fa-spin fa-5x"></i></div></div>
     <div class="ml_freespeaking_actionbox">
        <div class="ml_freespeaking_speakbtncontainer" style="width:246px;margin:auto;">
                {{> mod_readaloud/ttrecorder}}
        </div>
        <div class="timerstatus_{{uniqueid}} ml_freespeaking_timerdisplay ml_recsession"></div>
        <div class="mod_readaloud_fs_wordgoal {{^countwords}}hidden{{/countwords}} ml_recsession">{{#str}} currentwordcount , mod_readaloud {{/str}}: <span class="ml_wordcount">0</span>/{{targetwordcount}}</div>
     </div>
</div>
{{> mod_readaloud/questionfooter}}