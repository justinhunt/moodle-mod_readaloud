{{!
    @template mod_readaloud/practice_results_stars

    Star ratings for practice feedback. JavaScript shows the one that matches the score.

    Example context (json):
    {}
}}
<div class="ra_practice_results_feedback mb-3">
    <div class="ra_practice_feedback_0stars">
        <div class="ra_practice_stars">☆☆☆☆☆</div>
    </div>
    <div class="ra_practice_feedback_1stars">
        <div class="ra_practice_stars text-warning">★☆☆☆☆</div>
    </div>
    <div class="ra_practice_feedback_2stars">
        <div class="ra_practice_stars text-warning">★★☆☆☆</div>
    </div>
    <div class="ra_practice_feedback_3stars">
        <div class="ra_practice_stars text-warning">★★★☆☆</div>
    </div>
    <div class="ra_practice_feedback_4stars">
        <div class="ra_practice_stars text-warning">★★★★☆</div>
    </div>
    <div class="ra_practice_feedback_5stars">
        <div class="ra_practice_stars text-warning">★★★★★</div>
    </div>
</div>