{{!
    @template mod_readaloud/additemlink

    Link or tile that opens the form for adding a quiz item of one type.

    Context variables required for this template:
    * wwwroot - Site URL
    * cmid - Course module id
    * type - Quiz item type
    * label - Link text
    * isbutton - Show the link as a button
    * modaleditform - If true, the form opens in a modal and no link is output

    Example context (json):
    {
        "wwwroot": "https://moodle.example.com",
        "cmid": 25,
        "type": "multichoice",
        "label": "Add question",
        "isbutton": true,
        "modaleditform": false
    }
}}
{{^modaleditform}}
    <a href="{{wwwroot}}/mod/readaloud/rsquestion/managersquestions.php?id={{cmid}}&type={{type}}" {{#isbutton}}class="btn btn-secondary m-3"{{/isbutton}}>
{{/modaleditform}}
    <div id="mod_readaloud_qedit_{{type}}" data-qtype="{{type}}" data-id="0" data-type="edit" class="mod_readaloud_addlink mod_readaloud_link_box">
      <div class='mod_readaloud_link_box_title'>
        {{label}}
      </div>
    </div>
{{^modaleditform}}
    </a>
{{/modaleditform}}