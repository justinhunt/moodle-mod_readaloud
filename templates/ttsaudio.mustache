{{!
    @template mod_readaloud/ttsaudio

    Button that plays a text to speech version of the question.

    Context variables required for this template:
    * itemttsaudio - Text to speak
    * itemttsaudiovoice - TTS voice
    * itemttsoption - TTS speed option
    * itemttsautoplay - Play automatically

    Example context (json):
    {
        "itemttsaudio": "Where do polar bears live?",
        "itemttsaudiovoice": "Joanna",
        "itemttsoption": 0,
        "itemttsautoplay": false
    }
}}
<div class="ttsaudio container"  id="{{uniqid}}_ttsaudio">
    <button type='button' id='{{uniqid}}' class="roundmini-audio-player">
        <audio id="{{uniqid}}_ttsaudioplayer" data-text="{{itemttsaudio}}" data-autoplay="{{itemttsautoplay}}"  data-ttsoption="{{itemttsoption}}" data-voice="{{itemttsaudiovoice}}" class="mod_readaloud_itemttsaudio"></audio>
        <i class="fa fa-volume-up" aria-hidden="true"></i>
    </button>
</div>
{{^element.frozen}}
    {{#js}}
        require(['jquery', 'mod_readaloud/ttsaudio'], function($, ttsaudio) {
            ttsaudio.init('{{uniqid}}');
        });
    {{/js}}
{{/element.frozen}}