{{!
    @template mod_readaloud/readreportplayer

    Playback of a reading attempt, or a placeholder while the audio is not ready.

    Context variables required for this template:
    * ready - Whether the audio is ready
    * src - URL of the audio file
    * UNIQID - Unique id for the player

    Example context (json):
    {
        "ready": true,
        "UNIQID": "ra_player_1",
        "src": "https://moodle.example.com/pluginfile.php/25/mod_readaloud/submission/5/attempt.mp3"
    }
}}

{{#ready}}
<div class="mod_readaloud_readreport_player">
    {{> mod_readaloud/audioplayer}}
</div>
{{/ready}}
{{^ready}}
 <div class="mod_readaloud_readreport_dummyplayer mod_readaloud_skeleton_box">
    <i class="fa fa-volume-up"></i>
</div>
{{/ready}}