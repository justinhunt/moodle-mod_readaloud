{{!
    @template mod_readaloud/qi_speakinggapfill

    Speaking gap fill quiz item. JavaScript builds the questions from the item data.

    Context variables required for this template:
    * uniqueid - Unique id of the item, used to build element ids
    * itemtext - Question text (HTML)
    * rtl - CSS class for right-to-left languages, or empty
    * horizontal - Whether the item content uses the two column layout
    * (recorder fields) - See ttrecorder

    Example context (json):
    {
        "id": 19,
        "number": 9,
        "type": "speakinggapfill",
        "name": "recordbutton",
        "uniqueid": "speakinggapfill9",
        "itemtext": "<p>Listen and answer the question about polar bears.</p>",
        "rtl": "",
        "horizontal": false,
        "passagehash": "en-US|abc123def456",
        "waveheight": 75,
        "region": "useast1",
        "language": "en-US",
        "asrurl": "https://useast.ls.poodll.com/transcribe",
        "speechtoken": "speech-token-value",
        "speechtokenregion": "useast1",
        "speechtokentype": "assemblyai",
        "speechtokenvalidseconds": 600,
        "forcestreaming": false,
        "maxtime": 60,
        "savemedia": 1,
        "savemediaregion": "useast1",
        "cloudpoodlltoken": "cloudpoodll-token-value",
        "wwwroot": "https://moodle.example.com",
        "appid": "mod_readaloud",
        "owner": "owner-hash-value",
        "transcode": 1,
        "transcribemedia": 1,
        "expiredays": 365,
        "mediatype": "audio",
        "cloudpoodllurl": "https://cloud.poodll.com",
        "label": "Record",
        "pressed": "false"
    }
}}
{{> mod_readaloud/questionheader}}
<div class="readaloud_sgapfill_player_box gapfill-container">
    <div style="display:none;" class="sgapfill_results">{{#str}}gapfill_results, mod_readaloud{{/str}}</div>

    <div class="sgapfill_title text-center">{{#str}}speakinggapfill, mod_readaloud{{/str}}</div>

    <div class="sgapfill_mainmenu">
        <div class="sgapfill_loaded" style="display:none;">
            <button disabled class='btn btn-block btn-primary sgapfill_start_btn'>
                <i class='fa fa-play'></i> {{#str}}start, mod_readaloud{{/str}}
            </button>
        </div>
        <div class="sgapfill_not_loaded">
            <p>{{#str}}loading, mod_readaloud{{/str}}</p>
        </div>
    </div>

    <div class="progress-container d-flex" style="display:none;">
        <div id="progresstimer" class="flex-grow-1"></div>
        <div>
            <i style="display:none;" class="fa fa-clock-o" aria-hidden="true"></i>
        </div>
    </div>

    <div style="display:none;" class="sgapfill_listen_cont">
        <button class="btn btn-secondary sgapfill_listen_btn">
            <i class="fa fa-volume-up"></i>
        </button>
    </div>

    <div style="display:none;" class="question"></div>

    <div style="display:none;" class="sgapfill_controls">
        {{> mod_readaloud/ttrecorder}}
        <button class="btn btn-danger sgapfill_ctrl-btn sgapfill_skip_btn">
            {{#str}}skip, mod_readaloud{{/str}} <i class="fa fa-arrow-right"></i>
        </button>
    </div>

    <div class="sgapfill_resultscontainer"></div>

</div>

{{> mod_readaloud/questionfooter}}