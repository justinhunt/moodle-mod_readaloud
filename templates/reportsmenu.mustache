{{!
    @template mod_readaloud/reportsmenu

    Menu of the reports available to a teacher.

    Context variables required for this template:
    * reports - List of reports: button (HTML), text

    Example context (json):
    {
        "reports": [
            {
                "button": "<button type=\"button\" class=\"btn btn-secondary\">Course attempts</button>",
                "text": "All attempts in this course."
            }
        ]
    }
}}
{{#str}}reportsmenutoptext, mod_readaloud{{/str}}
<div class="readaloud_reportsmenu_box">
    {{#reports}}
        <div class="readaloud_reportsmenu_item">
            <div class="readaloud_reportsmenu_itembutton">
                {{{button}}}
                {{text}}
            </div>
        </div>
    {{/reports}}
</div>