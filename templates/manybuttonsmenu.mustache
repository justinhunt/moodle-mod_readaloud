{{!
    @template mod_readaloud/manybuttonsmenu

    Menu of cards, each with a title, a description and some content (usually a button).

    Context variables required for this template:
    * items - List of cards: title, description, content (HTML)

    Example context (json):
    {
        "items": [
            {
                "title": "Push passage",
                "description": "Copy the passage to all clones of this activity.",
                "content": "<button type=\"button\" class=\"btn btn-secondary\">Push</button>"
            }
        ]
    }
}}
<div class="mod_readaloud_manybuttonsmenu_container">

{{#items}}
<div class="mod_readaloud_manybuttonsmenu_item card">
    <div class="card-body">
        <h5 class="mod_readaloud_rm_card-title">{{title}}</h5>
        <div class="mod_readaloud_rm_description card-text">{{description}}</div>
        <div class="mod_readaloud_rm_content">
            {{{content}}}
        </div>
    </div >
</div>
{{/items}}
</div>