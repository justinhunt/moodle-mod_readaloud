{{!
    @template mod_readaloud/itemlistitem

    One row of the quiz item table.

    Context variables required for this template:
    * id - Item id
    * index - Position in the list
    * name - Item name
    * type - Item type
    * typelabel - Human readable item type
    * up - Pix icon data for the move up icon
    * down - Pix icon data for the move down icon

    Example context (json):
    {
        "id": 11,
        "index": 1,
        "name": "Polar bears 1",
        "type": "multichoice",
        "typelabel": "Multiple choice",
        "up": {
            "key": "t/up",
            "component": "core",
            "title": "Move up"
        },
        "down": {
            "key": "t/down",
            "component": "core",
            "title": "Move down"
        }
    }
}}
<tr id="mod_readaloud_item_row_{{id}}" class="mod_readaloud_item_row" data-id="{{id}}">
    <td class="cell c0">
    <label><input name="deletequestionid[]" type="checkbox" value="{{id}}" data-action="toggle" data-toggle="slave" data-togglegroup="delete-question"></label>
    </td>
    <td class="itemnumber cell c1" style="">{{index}}</td>
    <td class="itemid cell c2" style="">{{name}}</td>
    <td class="itemname cell c3" style="">{{typelabel}}</td>
    <td class="itemdate cell c4" style="">
        <a href="#" class="mod_readaloud_item_move" data-id="{{id}}" data-direction="up">{{#pix}}{{up.key}},{{up.component}},{{up.title}}{{/pix}}</a>
        <a href="#" class="mod_readaloud_item_move" data-id="{{id}}" data-direction="down">{{#pix}}{{down.key}},{{down.component}},{{down.title}}{{/pix}}</a>
    </td>
    <td class="itemaction cell c5" style="">
        <a href="#" class="mod_readaloud_item_row_editlink" data-id="{{id}}" data-qtype='{{type}}' data-type="edit" aria-label="{{#str}}edititem, mod_readaloud{{/str}}">{{#pix}}i/edit{{/pix}}</a>
        <a href="#" class="mod_readaloud_item_row_previewlink" data-id="{{id}}" data-name="{{name}}" data-type="preview" aria-label="{{#str}}previewitem, mod_readaloud{{/str}}">{{#pix}}i/preview{{/pix}}</a>
        <a href="#" class="mod_readaloud_item_row_duplicatelink" data-id="{{id}}" data-name="{{name}}" data-type="duplicate" aria-label="{{#str}}duplicateitem, mod_readaloud{{/str}}">{{#pix}}t/copy{{/pix}}</a>
        <a href="#" class="mod_readaloud_item_row_deletelink" data-id="{{id}}" data-name="{{name}}" data-type="delete" aria-label="{{#str}}deleteitem, mod_readaloud{{/str}}">{{#pix}}i/delete{{/pix}}</a>
    </td>
</tr>