{{!
    @template mod_readaloud/footernav

    Menu listing the activity steps with their completion status.

    Context variables required for this template:
    * stepsdata - List of steps: stepnumber, mode, classes, statusicon, label, modeicon (SVG)
    * M_FOOTERNAV_CONTAINER - CSS id/class of the menu container
    * M_MENUBUTTONS_CONTAINER - CSS id/class of the buttons container

    Example context (json):
    {
        "M_FOOTERNAV_CONTAINER": "mod_readaloud_footernav_container",
        "M_MENUBUTTONS_CONTAINER": "mod_readaloud_menubuttons_container",
        "stepsdata": [
            {
                "stepnumber": 1,
                "mode": "preview",
                "classes": "complete",
                "label": "Listen",
                "statusicon": "https://moodle.example.com/theme/image.php/boost/mod_readaloud/1/checked",
                "modeicon": "<svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/></svg>"
            },
            {
                "stepnumber": 8,
                "mode": "startnoshadow",
                "classes": "current",
                "label": "Read",
                "statusicon": "https://moodle.example.com/theme/image.php/boost/mod_readaloud/1/current",
                "modeicon": "<svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/></svg>"
            }
        ]
    }
}}
<div id="{{M_FOOTERNAV_CONTAINER}}" class="{{M_FOOTERNAV_CONTAINER}}">
    <div id="{{M_MENUBUTTONS_CONTAINER}}" class="{{M_MENUBUTTONS_CONTAINER}} w-100">
        <ol class="main-nav list-unstyled p-0">
            {{#stepsdata}}
            <li class="nav-item mode-chooser {{classes}} p-3 mb-4 d-flex rounded" data-step="{{stepnumber}}">
                <a href="javascript:void(0)" class="nav-link h6 w-100 mb-0 d-flex align-items-center justify-content-between" data-mode="{{mode}}">
                    <div class="nav-text-group">
                        <span class="step-icon flex-shrink-0 mr-2">
                            {{{modeicon}}}
                        </span>
                        <span class="nav-label">{{label}}</span>
                    </div>
                    <img src="{{statusicon}}" alt="{{label}}" class="nav-status-icon ml-auto" />
                </a>
                <!--{{#warningtext}}
                <span class="mod_readaloud_menubutton_warning">{{warningtext}}</span>
                {{/warningtext}}-->
            </li>
            {{/stepsdata}}
            {{^stepsdata}}
            <li>No steps available</li>
            {{/stepsdata}}
        </ol>
    </div>
</div>