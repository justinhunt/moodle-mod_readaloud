{{!
    @template mod_readaloud/resultspanel

    Hidden panel for a quiz item score.

    Example context (json):
    {}
}}
<div class="row readaloud_resultspanel" style="display: none;">
    <div class="col-md-6" style="margin-left: auto;margin-right: auto">
        <div class="readaloud_resultspanel_swish" data-possible="0" data-achieved="0">
            <span class="readaloud_swishstars"></span><span class="readaloud_swishscore"></span>
        </div>
    </div>
</div>