{{!
    @template mod_readaloud/cbcredentialspanel

    In page setup panel shown to administrators when the site has no Cloud Poodll API credentials.
    Lets them paste credentials in, copy credentials from another Poodll plugin on the site, or
    take a free trial without leaving their Moodle site.

    Example context (json):
    {
        "errormessage": "",
        "formaction": "https://mymoodle.com/mod/readaloud/cbsavecreds.php",
        "sesskey": "abc123",
        "returnurl": "https://mymoodle.com/mod/readaloud/view.php?id=2",
        "apiuserid": "mod_readaloud_cbapiuser",
        "apisecretid": "mod_readaloud_cbapisecret",
        "currentapiuser": "",
        "currentapisecret": "",
        "settingsurl": "https://mymoodle.com/admin/settings.php?section=modsettingreadaloud",
        "foundcreds": false,
        "apiuserselector": "#mod_readaloud_cbapiuser",
        "apisecretselector": "#mod_readaloud_cbapisecret",
        "fetchcbpageurl": "https://mymoodle.com/mod/readaloud/fetchcbpage.php"
    }
}}
<div class="mod_readaloud_cbcredentialspanel card">
    <div class="card-body">
        <h3 class="card-title">{{#str}}cbsetupheading, mod_readaloud{{/str}}</h3>
        {{#errormessage}}
            <div class="alert alert-warning">{{{errormessage}}}</div>
        {{/errormessage}}
        <p>{{#str}}cbsetupintro, mod_readaloud{{/str}}</p>
        <p>
            {{#foundcreds}}{{#str}}cbsetupfound, mod_readaloud{{/str}}{{/foundcreds}}
            {{^foundcreds}}{{#str}}cbsetupnotfound, mod_readaloud{{/str}}{{/foundcreds}}
        </p>

        {{> mod_readaloud/cbmanagecreds }}

        <form action="{{{formaction}}}" method="post" class="mt-3">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="returnurl" value="{{returnurl}}">
            <div class="form-group">
                <label for="{{apiuserid}}">{{#str}}apiuser, mod_readaloud{{/str}}</label>
                <input type="text" class="form-control" id="{{apiuserid}}" name="apiuser"
                       value="{{currentapiuser}}" autocomplete="off" spellcheck="false">
            </div>
            <div class="form-group">
                <label for="{{apisecretid}}">{{#str}}apisecret, mod_readaloud{{/str}}</label>
                <input type="text" class="form-control" id="{{apisecretid}}" name="apisecret"
                       value="{{currentapisecret}}" autocomplete="off" spellcheck="false">
            </div>
            <button type="submit" class="btn btn-primary">{{#str}}cbsavecredentials, mod_readaloud{{/str}}</button>
        </form>

        <p class="mt-3 mb-0">
            <a href="{{{settingsurl}}}">{{#str}}cbgotosettings, mod_readaloud{{/str}}</a>
        </p>
    </div>
</div>
