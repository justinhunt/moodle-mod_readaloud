{{!
    @template mod_readaloud/mediapromptfieldset

    Opening of a fieldset for one media prompt in the quiz item form. The fieldset is closed by the form
    code after its fields are added.

    Context variables required for this template:
    * mediatype - Media prompt type
    * keyfield - Name of the form field that holds the prompt
    * legend - Fieldset legend
    * instructions - Instructions for this prompt

    Example context (json):
    {
        "mediatype": "addmedia",
        "keyfield": "addmedia",
        "legend": "Image, audio or video",
        "instructions": "Upload an image, audio or video file to show with the question."
    }
}}
<fieldset id='ra_mediaprompt_panel_{{mediatype}}' class='ra_mediaprompt_panel border p-2' data-mediaprompt="{{mediatype}}"
          data-keyfield="{{keyfield}}" style='display: none'>
  <legend class='w-auto'>{{legend}}</legend>
  <button type='button' class='close' data-dismiss='fieldset' aria-label='Close'><span aria-hidden='true'>&times;</span></button>
  <div class='ra_mediaprompt_instructions'>{{instructions}}</div>
  {{! we deliberately do not close the fieldset. that is done after form contents are appended }}
  