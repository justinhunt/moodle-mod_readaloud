{{!
    @template mod_readaloud/listen

    The Read Aloud listen view (preview mode).
    Displays the activity header with preview instructions and allows listening to model audio.

    Context variables required for this template:
    * backurl - URL to return to home/menu
    * passagepictureurl - URL to passage picture (optional)
    * instructions - Preview/listen mode instructions text
    * playbutton - Play button configuration
    * passagehtml - The passage (HTML)

    Example context (json):
    {
        "backurl": "https://moodle.example.com/mod/readaloud/view.php?id=42",
        "passagepictureurl": "https://moodle.example.com/pluginfile.php/42/mod_readaloud/passagepicture/0/picture.png",
        "instructions": "Listen to a speaker read the passage aloud. You do not need to read aloud.",
        "passagehtml": "<p>Polar bears live in the Arctic.</p>",
        "playbutton": {
            "name": "playbutton",
            "label": "Play",
            "pressed": "false"
        },
        "M_STOPANDPLAY": "mod_readaloud_stopandplay",
        "M_PLAY_BTN": "mod_readaloud_button-play",
        "M_STOP_BTN": "mod_readaloud_button-stop"
    }
}}

<section id="mod_readaloud_listenmode" class="listen-mode" role="region" aria-labelledby="listen-title">
    <h2 id="listen-title" class="visually-hidden">{{#str}} listen, mod_readaloud {{/str}}</h2>

    {{< mod_readaloud/activity_header_inpage}}
     {{$instructions}}{{#str}} previewhelp, mod_readaloud {{/str}}{{/instructions}}
    {{/ mod_readaloud/activity_header_inpage}}

    {{> mod_readaloud/passagecontainer}}

    <div class="controls d-flex flex-column align-items-center p-3 mt-4" role="group" aria-label="Audio controls">
        {{#playbutton}}
            {{> mod_readaloud/playbutton}}
        {{/playbutton}}

        <!-- Button trigger modal -->
        <button
            type="button"
            id="mod_readaloud_hidelistenquitmodal"
            class="btn"
            data-bs-toggle="modal"
            data-bs-target="#mod_readaloud_listenquitmodal"
            style="display: none;"
            aria-hidden="true"
            tabindex="-1"
            aria-controls="mod_readaloud_listenquitmodal"
        >
            hide quit listening modal
        </button>

        {{> mod_readaloud/listenquit_modal}}
    </div>
</section>
