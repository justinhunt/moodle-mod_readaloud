{{!
    @template mod_readaloud/finalreport

    Final report step: summary of the reading attempts and, if the quiz step is enabled, the quiz
    result.

    Context variables required for this template:
    * fullreportdata - Report data: fullreportcontainer, attemptssummary and generalfeedback
    * stepsenabled - Which steps are enabled, keyed by step name
    * hasquizquestions - Whether the activity has quiz questions
    * M_FEEDBACK_CONTAINER - CSS id/class of the feedback container

    Example context (json):
    {
        "activityname": "Reading about Polar Bears",
        "fullreportdata": {
            "fullreportcontainer": "mod_readaloud_fullreport_container",
            "hasattemptsummary": true,
            "attemptssummary": {
                "totalattempts": 2,
                "av_wpm": 104,
                "av_accuracy": 86,
                "av_words": 120,
                "stars": [
                    "fa-solid fa-star text-warning",
                    "fa-solid fa-star text-warning",
                    "fa-solid fa-star text-warning",
                    "fa-solid fa-star-half-stroke text-warning",
                    "fa-solid fa-star text-muted"
                ]
            },
            "generalfeedback": "Thanks for reading.",
            "total": 80,
            "stars": [
                "fa-solid fa-star text-warning",
                "fa-solid fa-star text-warning",
                "fa-solid fa-star text-warning",
                "fa-solid fa-star-half-stroke text-warning",
                "fa-solid fa-star text-muted"
            ]
        },
        "stepsenabled": {
            "step_quiz": true
        },
        "hasquizquestions": true,
        "M_FEEDBACK_CONTAINER": "mod_readaloud_feedback_container"
    }
}}
{{< mod_readaloud/activity_header_inpage}}
    {{$instructions}}
        {{#str}} finalreporthelp, mod_readaloud {{/str}}
    {{/instructions}}
{{/ mod_readaloud/activity_header_inpage}}

{{#fullreportdata}}
<div id="{{fullreportcontainer}}" class='mod_readaloud_finalreport {{fullreportcontainer}}'>

  {{>mod_readaloud/studentreadingattemptssummary}}
  {{#stepsenabled.step_quiz}}
     {{#hasquizquestions}}
      {{>mod_readaloud/studentquizattemptssummary}}
     {{/hasquizquestions}}
  {{/stepsenabled.step_quiz}}


    <div class="{{M_FEEDBACK_CONTAINER}} {{constants::M_POSTATTEMPT}}" id="{{M_FEEDBACK_CONTAINER}}">
        <div class="box py-3 generalbox mb-3">
            {{generalfeedback}}
        </div>
    </div>
</div>
{{/fullreportdata}}