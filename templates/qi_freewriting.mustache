{{!
    @template mod_readaloud/qi_freewriting

    Free writing quiz item.

    Context variables required for this template:
    * uniqueid - Unique id of the item, used to build element ids
    * itemtext - Question text (HTML)
    * rtl - CSS class for right-to-left languages, or empty
    * horizontal - Whether the item content uses the two column layout
    * textarearows - Number of rows in the text area
    * countwords - Whether to show the word count goal
    * targetwordcount - Target number of words

    Example context (json):
    {
        "id": 14,
        "number": 4,
        "type": "freewriting",
        "name": "Polar bears 4",
        "uniqueid": "freewriting4",
        "itemtext": "<p>Listen and answer the question about polar bears.</p>",
        "rtl": "",
        "horizontal": false,
        "textarearows": 6,
        "countwords": true,
        "targetwordcount": 50
    }
}}
{{> mod_readaloud/questionheader}}
<div class="readaloud_freewriting_box">
    <div class="ml_freewriting_resultsbox"></div>
    <div class="ml_freewriting_pendingbox hidden"><div class="text-center"><i class="fa-solid fa-spinner fa-spin fa-5x"></i></div></div>
        <div class="ml_freewriting_actionbox">
            <div class="ml_freewriting_textareacontainer">
                <textarea class="ml_freewriting_textarea" rows="{{textarearows}}" cols="50" placeholder="{{#str}}writehere, mod_readaloud{{/str}}"></textarea>
            </div>
            <a class="btn btn-primary ml_freewriting_submitbutton" href="#">{{#str}}submit, mod_readaloud{{/str}}</a>
            <div class="timerstatus_{{uniqueid}} ml_freewriting_timerdisplay ml_recsession"></div>
            <div class="mod_readaloud_fw_wordgoal {{^countwords}}hidden{{/countwords}} ml_recsession">{{#str}} currentwordcount , mod_readaloud {{/str}}: <span class="ml_wordcount">0</span>/{{targetwordcount}}</div>
        </div>
</div>
{{> mod_readaloud/questionfooter}}