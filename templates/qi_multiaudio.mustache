{{!
    @template mod_readaloud/qi_multiaudio

    Multiple choice quiz item where the student speaks the answer.

    Context variables required for this template:
    * uniqueid - Unique id of the item, used to build element ids
    * itemtext - Question text (HTML)
    * rtl - CSS class for right-to-left languages, or empty
    * horizontal - Whether the item content uses the two column layout
    * sentences - List of answers: index, indexplusone, prompt
    * (recorder fields) - See ttrecorder

    Example context (json):
    {
        "id": 16,
        "number": 6,
        "type": "multiaudio",
        "name": "recordbutton",
        "uniqueid": "multiaudio6",
        "itemtext": "<p>Listen and answer the question about polar bears.</p>",
        "rtl": "",
        "horizontal": false,
        "passagehash": "en-US|abc123def456",
        "waveheight": 75,
        "region": "useast1",
        "language": "en-US",
        "asrurl": "https://useast.ls.poodll.com/transcribe",
        "speechtoken": "speech-token-value",
        "speechtokenregion": "useast1",
        "speechtokentype": "assemblyai",
        "speechtokenvalidseconds": 600,
        "forcestreaming": false,
        "maxtime": 60,
        "savemedia": 1,
        "savemediaregion": "useast1",
        "cloudpoodlltoken": "cloudpoodll-token-value",
        "wwwroot": "https://moodle.example.com",
        "appid": "mod_readaloud",
        "owner": "owner-hash-value",
        "transcode": 1,
        "transcribemedia": 1,
        "expiredays": 365,
        "mediatype": "audio",
        "cloudpoodllurl": "https://cloud.poodll.com",
        "label": "Record",
        "pressed": "false",
        "sentences": [
            {
                "index": 0,
                "indexplusone": 1,
                "sentence": "Polar bears live in the Arctic.",
                "prompt": "Polar bears live in the Arctic.",
                "mediaurl": "https://moodle.example.com/pluginfile.php/25/mod_readaloud/fileanswer1/11/bear.jpg"
            },
            {
                "index": 1,
                "indexplusone": 2,
                "sentence": "Polar bears live in the desert.",
                "prompt": "Polar bears live in the desert.",
                "mediaurl": "https://moodle.example.com/pluginfile.php/25/mod_readaloud/fileanswer2/11/desert.jpg"
            }
        ]
    }
}}
{{> mod_readaloud/questionheader}}
    {{#sentences}}
        <div class="row mcplayrow" id="{{uniqueid}}_option{{indexplusone}}">
            <div class="col-md-1 mcaudioplayer_{{indexplusone}}">
                <div class="mc_playbutton_container">
                    <button class="readaloud_mc_audioplayer mcplaytrigger btn btn-secondary" data-index="{{index}}" id="{{uniqueid}}_audioplayer{{indexplusone}}">
                        <i class="fa fa-play readaloud_mc_playstate"></i>
                    </button>
                </div>
            </div>
            <div class="col-md-11 mcaudiotranscript_{{index}}">
                <div class="readaloud_mc_response {{rtl}}" data-index="{{index}}" >
                    <span class="readaloud_sentence">{{prompt}}</span>
                    <span class="readaloud_mc_resultbox">
                    <i class="fa fa-check fa-lg readaloud_mc_right" style="display: none;"></i>
                    <i class="fa fa-times fa-lg readaloud_mc_wrong" style="display: none;"></i>
                    </span>
                </div>
            </div>
        </div>
    {{/sentences}}
    {{> mod_readaloud/ttrecorder}}
{{> mod_readaloud/questionfooter}}