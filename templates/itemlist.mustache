{{!
    @template mod_readaloud/itemlist

    Table of the quiz items in the activity, with bulk delete.

    Context variables required for this template:
    * display - CSS display value for the list container
    * tableid - Id of the table
    * items - List of quiz items (see itemlistitem)
    * up - Pix icon data for the move up icon
    * down - Pix icon data for the move down icon

    Example context (json):
    {
        "display": "block",
        "tableid": "mod_readaloud_qpanel",
        "config": {
            "sesskey": "abc123"
        },
        "up": {
            "key": "t/up",
            "component": "core",
            "title": "Move up"
        },
        "down": {
            "key": "t/down",
            "component": "core",
            "title": "Move down"
        },
        "items": [
            {
                "id": 11,
                "index": 1,
                "name": "Polar bears 1",
                "type": "multichoice",
                "typelabel": "Multiple choice"
            },
            {
                "id": 12,
                "index": 2,
                "name": "Polar bears 2",
                "type": "freewriting",
                "typelabel": "Free writing"
            }
        ]
    }
}}
<div id="mod_readaloud_items_cont" class="mod_readaloud_items_cont" style="display: {{display}};">
    <form method="post">
        <input type="hidden" name="sesskey" value="{{config.sesskey}}" />
        <div class="mod_readaloud_bdbtn_container" id="mod_readaloud_bdbtn_container">
            <button class="btn btn-primary d-none" tabindex="0" aria-controls="mod_readaloud_qpanel" type="button"
                    id="mod_readaloud_deleteconfirmation" name="action" value="bulkdelete">
                    <span>{{#str}}bulkdelete, mod_readaloud{{/str}}</span>
            </button>
        </div>
    <table class="generaltable mod_readaloud_qpanel" id="{{tableid}}">
        <thead>
        <tr>
                <th class="header c0" scope="col">
                    <input id="select-all-question" name="select-all-question" type="checkbox" value="" data-action="toggle" data-toggle="master" data-togglegroup="delete-question" data-toggle-selectall="{{#str}} selectall {{/str}}" data-toggle-deselectall="{{#str}} deselectall {{/str}}">
                    <label for="select-all-question" class="">{{#str}} selectall {{/str}}</label>
                </th>
                <th class="header c1 number" style="" scope="col">#</th>
                <th class="header c2 name" style="" scope="col">{{#str}}itemname, mod_readaloud{{/str}}</th>
                <th class="header c3 type" style="" scope="col">{{#str}}itemtype, mod_readaloud{{/str}}</th>
                <th class="header c4 date" style="" scope="col">{{#str}}order, mod_readaloud{{/str}}</th>
                <th class="header c5 action" style="" scope="col">{{#str}}action, mod_readaloud{{/str}}</th>
        </tr>
        </thead>
        <tbody>
        {{#items}}
            {{> mod_readaloud/itemlistitem}}
        {{/items}}
        </tbody>
    </table>
    </form>
</div>
{{#js}}
require(['core/checkbox-toggleall', 'mod_readaloud/bulkselect'], function(ToggleAll) {
    ToggleAll.init();
});
{{/js}}