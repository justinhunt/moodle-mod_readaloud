{{!
    @template mod_readaloud/playbutton

    Play/stop button for the model audio in the listen step.

    Context variables required for this template:
    * name - Control name
    * label - Accessible label
    * pressed - Initial aria-pressed state
    * M_STOPANDPLAY - Id of the button container
    * M_PLAY_BTN - Id of the play icon
    * M_STOP_BTN - Id of the stop icon

    Example context (json):
    {
        "name": "playbutton",
        "label": "Play",
        "pressed": "false",
        "M_STOPANDPLAY": "mod_readaloud_stopandplay",
        "M_PLAY_BTN": "mod_readaloud_button-play",
        "M_STOP_BTN": "mod_readaloud_button-stop"
    }
}}
<div id="{{M_STOPANDPLAY}}" class="d-flex flex-column align-items-center">
    <button
        class="control control--playbutton"
        type="button"
        aria-label="{{label}}"
        aria-pressed="{{pressed}}"
        aria-describedby="playbutton-desc"
        data-control="{{name}}"
    >
        <span id="{{M_PLAY_BTN}}">
        {{> mod_readaloud/play}}
        </span>
        <span id="{{M_STOP_BTN}}">
        {{> mod_readaloud/stop}}
        </span>
    </button>
    <span id="playbutton-desc" class="control-label p-2">
        {{#str}} taptolisten, mod_readaloud {{/str}}
    </span>
</div>
